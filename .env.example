# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Giá trị dưới đây là giả, chỉ để mô tả định dạng.

APP_DOMAIN=viec.staging.example.com

POSTGRES_USER=viec
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=viec
DATABASE_URL=postgres://viec:change-me-long-random@db:5432/viec

SESSION_SECRET=replace-with-32-plus-random-bytes

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=change-me
SMTP_FROM=viec@example.com

# Khoá CÔNG KHAI của age. Khoá riêng không bao giờ đặt ở đây.
BACKUP_AGE_PUBLIC_KEY=age1replacewithpublickeygeneratedbyage-keygen

# Loại đích sao lưu: s3 (Cloudflare R2, MVP) hoặc sftp (VPS trong nước, khi chuyển).
# Đổi loại chỉ cần đổi biến này và các biến tương ứng bên dưới. Scripts không đổi.
BACKUP_TYPE=s3

# --- Khi BACKUP_TYPE=s3 ---
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Backblaze B2 (S3 API): https://s3.<region>.backblazeb2.com
BACKUP_ENDPOINT=https://replace-me.example.com
# Cloudflare R2 dùng BACKUP_PROVIDER=Cloudflare. Backblaze B2 dùng BACKUP_PROVIDER=Other.
BACKUP_PROVIDER=Cloudflare
BACKUP_ACCESS_KEY=replace-me
BACKUP_SECRET_KEY=replace-me

# --- Khi BACKUP_TYPE=sftp ---
# Thư mục đích trên VPS sao lưu (đường dẫn tương đối với thư mục home của người dùng SFTP).
BACKUP_SFTP_HOST=backup.example.vn
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=backup
# Khoá riêng SFTP đặt trong thư mục ./secrets/backup_sftp_key (không commit).
BACKUP_SFTP_KEY_FILE=/run/secrets/backup_sftp_key
# Khoá máy chủ đã ghim, đặt trong ./secrets/backup_known_hosts (không commit).
BACKUP_SFTP_KNOWN_HOSTS=/run/secrets/backup_known_hosts

# Tên thư mục (bucket) đích. Dùng chung cho cả hai loại.
BACKUP_BUCKET=viec-backups-staging

ALERT_EMAIL=ops@example.com

# Ngưỡng lệch số dòng khi thử khôi phục (phần trăm)
RESTORE_TOLERANCE_PERCENT=1
