# App A – Việc nội bộ: biến môi trường khi chạy app trên máy dev (npm run dev).
# Khi chạy bằng Docker Compose, dùng file .env ở thư mục gốc repo (xem /.env.example).
# KHÔNG commit file .env.

DATABASE_URL="postgresql://viec:viec@localhost:5432/viec_dev"

# Sinh bằng: openssl rand -hex 32
AUTH_SECRET="replace-with-64-hex-chars"
# Máy dev được phép http://localhost; production bắt buộc https://
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Để trống SMTP_HOST trên máy dev: magic link được in ra console (production sẽ từ chối chạy)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Việc nội bộ <no-reply@example.com>"

BRAND_NAME="Việc nội bộ"
NEXT_PUBLIC_BRAND_NAME="Việc nội bộ"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Quản trị viên"
