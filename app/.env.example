# ============================================================
# App A - Việc nội bộ | .env.example
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git
# ============================================================

# --- Database ---
# PostgreSQL connection string (dùng service "db" trong docker-compose)
DATABASE_URL="postgresql://viec_user:STRONG_PASSWORD@db:5432/viec_db"

# --- NextAuth.js ---
# Sinh bằng: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-random-64-char-hex"
# URL public của app (không có trailing slash)
NEXTAUTH_URL="https://viec.yourdomain.com"

# --- SMTP (Brevo Free) ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login@email.com"
# Brevo SMTP Key (khác với password đăng nhập)
SMTP_PASS="your-brevo-smtp-key"
SMTP_FROM="Việc nội bộ <no-reply@yourdomain.com>"

# --- White-label brand ---
BRAND_NAME="Việc nội bộ"
NEXT_PUBLIC_BRAND_NAME="Việc nội bộ"
# URL logo (để trống = dùng text brand name)
BRAND_LOGO_URL=""
# Màu chủ đạo (hex, dùng cho white-label)
PRIMARY_COLOR="#2563eb"

# --- App domain (dùng trong email magic link) ---
APP_DOMAIN="https://viec.yourdomain.com"

# --- Notification Gateway (tùy chọn) ---
# Telegram
# TELEGRAM_BOT_TOKEN="bot_token_from_botfather"
# TELEGRAM_DEFAULT_CHAT_ID="-100xxxxxxxxx"

# Webhook (Capbot / n8n / Make.com)
# WEBHOOK_URL="https://your-webhook-endpoint.com/hook"
# WEBHOOK_SECRET="shared-secret-for-hmac"

# Zalo OA (khi có API key)
# ZALO_OA_TOKEN=""

# --- Feature flags ---
# Bật/tắt kênh thông báo: true | false
NOTIFY_EMAIL_ENABLED="true"
NOTIFY_TELEGRAM_ENABLED="false"
NOTIFY_WEBHOOK_ENABLED="false"
NOTIFY_ZALO_ENABLED="false"
